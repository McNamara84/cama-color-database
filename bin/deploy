#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."
release_id=${1:?Usage: bin/deploy FULL_GIT_SHA}
[[ $release_id =~ ^[a-f0-9]{40}$ ]] || exit 2
: "${DEPLOY_HOST:?}" "${DEPLOY_USER:?}" "${DEPLOY_PATH:?}" "${DEPLOY_PHP:?}" "${DEPLOY_ORIGIN:?}"
# Restrict interpolated remote-shell arguments to literal, unambiguous values.
[[ $DEPLOY_HOST =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]*$ && $DEPLOY_USER =~ ^[a-zA-Z0-9][a-zA-Z0-9_-]*$ ]] || exit 2
[[ $DEPLOY_PATH =~ ^/[a-zA-Z0-9_./-]+$ && $DEPLOY_PHP =~ ^/[a-zA-Z0-9_./-]+$ ]] || exit 2
[[ $DEPLOY_PATH != *..* && ${#DEPLOY_PATH} -gt 5 ]] || exit 2
[[ $DEPLOY_ORIGIN =~ ^https://[a-zA-Z0-9.-]+(:[0-9]+)?$ ]] || exit 2
target="$DEPLOY_USER@$DEPLOY_HOST"
opts=(-o BatchMode=yes -o StrictHostKeyChecking=yes -o ConnectTimeout=15)
(cd build && sha256sum -c release.tar.gz.sha256)
ssh "${opts[@]}" "$target" "mkdir -p '$DEPLOY_PATH/releases'"
scp "${opts[@]}" build/release.tar.gz "$target:$DEPLOY_PATH/.incoming-$release_id.tar.gz"
checksum=$(sha256sum build/release.tar.gz | cut -d ' ' -f1)
ssh "${opts[@]}" "$target" "set -e
cd '$DEPLOY_PATH'
printf '%s  %s\n' '$checksum' '.incoming-$release_id.tar.gz' | sha256sum -c -
if test -e 'releases/$release_id'; then
    test \"\$(cat 'releases/$release_id/.archive-sha256')\" = '$checksum'
else
    mkdir 'releases/$release_id'
    tar -xzf '.incoming-$release_id.tar.gz' -C 'releases/$release_id'
    printf '%s\n' '$checksum' > 'releases/$release_id/.archive-sha256'
fi
rm '.incoming-$release_id.tar.gz'
'$DEPLOY_PHP' 'releases/$release_id/bin/activate.php' '$DEPLOY_PATH' '$release_id' '$DEPLOY_ORIGIN'"
