#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
release_id=${1:?Usage: bin/package FULL_GIT_SHA}
php -r 'require "vendor/autoload.php"; Cama\Infrastructure\ReleaseManager::validateId($argv[1]);' "$release_id"
mkdir -p build
stage=$(mktemp -d "$PWD/build/package.XXXXXXXX")
trap 'rm -rf "$stage"' EXIT HUP INT TERM
for item in src public templates migrations phinx.php composer.json composer.lock LICENSE; do
    cp -R "$item" "$stage/"
done
mkdir "$stage/bin"
cp bin/doctor.php bin/activate.php bin/plesk-deploy.php bin/install.php "$stage/bin/"
printf '%s\n' "$release_id" > "$stage/RELEASE"
composer install --working-dir="$stage" --no-dev --no-interaction --no-scripts --prefer-dist --optimize-autoloader --no-progress
cp /usr/local/bin/composer "$stage/bin/composer.phar"
(cd "$stage" && find . -type f ! -name MANIFEST.sha256 -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | sed 's#  \./#  #') > "$stage/MANIFEST.sha256"
find "$stage" -type d -exec chmod 755 {} +
find "$stage" -type f -exec chmod 644 {} +
tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner -C "$stage" -cf - . | gzip -n > build/release.tar.gz
(cd build && sha256sum release.tar.gz > release.tar.gz.sha256)
echo 'Release package written to build/release.tar.gz'
