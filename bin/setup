#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
if [ -e .env ]; then
    echo '.env existiert bereits; keine Änderungen vorgenommen.'
    exit 0
fi
umask 077
cp .env.example .env
for key in APP MIGRATION ROOT TEST; do
    secret=$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')
    sed -i "s/CHANGE_ME_$key/$secret/" .env
done
sed -i "s/LOCAL_UID=1000/LOCAL_UID=$(id -u)/; s/LOCAL_GID=1000/LOCAL_GID=$(id -g)/" .env
mkdir -p var/cache var/log var/sessions build
echo '.env mit zufälligen lokalen Passwörtern erstellt.'
