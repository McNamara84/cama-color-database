APP_ENV=production
APP_DEBUG=false
APP_NAME="CAMA Color Database"

# Save as shared/.env outside the public document root, with mode 0600.
# Do not copy the Docker .env to Netcup. Use the hosting database credentials.
# Omitting APP_RUNTIME_DIR uses shared/var, resolved correctly in CLI and Web-PHP.
DB_HOST=REPLACE_WITH_HOSTING_DATABASE_HOST
DB_PORT=3306
DB_NAME=REPLACE_WITH_DATABASE_NAME
DB_USER=REPLACE_WITH_APPLICATION_USER
DB_PASSWORD='REPLACE_WITH_APPLICATION_PASSWORD'
DB_MIGRATION_USER=REPLACE_WITH_MIGRATION_USER
DB_MIGRATION_PASSWORD='REPLACE_WITH_MIGRATION_PASSWORD'
