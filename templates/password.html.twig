{% extends 'layout.html.twig' %}
{% block title %}Passwort ändern · {{ app_name }}{% endblock %}
{% block content %}
<section class="account-panel">
<p class="eyebrow">Dein Account</p><h1>Passwort ändern</h1>
{% if user.mustChangePassword %}<p>Bitte ersetze dein Startpasswort durch ein eigenes Passwort, bevor du fortfährst.</p>{% endif %}
{% include 'form-errors.html.twig' %}
<form method="post" action="/account/password" class="account-form">
    <input type="hidden" name="_csrf" value="{{ csrf }}">
    <label for="current-password">Aktuelles Passwort</label><input id="current-password" name="current_password" type="password" autocomplete="current-password" maxlength="128" required>
    <label for="password">Neues Passwort</label><input id="password" name="password" type="password" autocomplete="new-password" minlength="15" maxlength="128" aria-describedby="password-help" required>
    <p class="field-help" id="password-help">15 bis 128 Zeichen. Eine lange, nur hier verwendete Passphrase eignet sich gut.</p>
    <label for="password-confirmation">Neues Passwort wiederholen</label><input id="password-confirmation" name="password_confirmation" type="password" autocomplete="new-password" minlength="15" maxlength="128" required>
    <button type="submit">Passwort speichern</button>
</form>
</section>
{% endblock %}
